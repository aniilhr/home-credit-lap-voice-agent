# ---------------------------------------------------------------------------
# Live AI mode (Gemini). Without a key the console still runs in rules-engine mode.
# Create a key at https://aistudio.google.com/apikey and paste it below.
# ---------------------------------------------------------------------------
GEMINI_API_KEY=

# Model id. The "latest" alias follows Google's current Flash model; pin a
# specific id (see the model list in Google AI Studio) for reproducible tests.
GEMINI_MODEL=gemini-flash-latest

# Optional tuning
# GEMINI_TEMPERATURE=0.4
# GEMINI_TIMEOUT_MS=30000
# Reasoning depth: a level (minimal, low, medium, high) for newer models,
# or a token budget such as 0 for 2.5-series models. Unset = model default.
# GEMINI_THINKING=low

# Local console server
PORT=4173
HOST=127.0.0.1
